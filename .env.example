PORT=3001
DATABASE_URL=mysql://root:CHANGE_ME@mysql:3306/infinity_echo
DB_ROOT_PASSWORD=CHANGE_ME
AMI_HOST=asterisk
AMI_PORT=5038
AMI_USERNAME=broadcastapi
AMI_SECRET=abd0c26f1e947583
ASTERISK_ENDPOINTS_CONF_PATH=/etc/asterisk/endpoints.conf
ANNOUNCEMENTS_DIR=/announcements
PAGE_DURATION=10
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_DISPLAY=Institute Admin
SESSION_SECRET=CHANGE_ME_generate_a_random_string
# Docker host's LAN IP — used by the Asterisk entrypoint to render SDP media
# addresses so phones/speakers send RTP to the published port range.
# Change this to the actual host IP at deployment.
HOST_IP=10.20.30.20
# Shared secret for the PA AGI -> API trigger route (initiator dials an extension).
PA_TRIGGER_SECRET=CHANGE_ME_pa_trigger_secret
# Container memory ceilings (Docker mem_limit). Defaults are sized for a 2 GB host;
# raise them on a larger NAS/server. Caps are ceilings, not reservations, so normal
# usage sits well below these — they exist so a leak is OOM-killed and restarted
# instead of starving the host.
API_MEM_LIMIT=512m
ASTERISK_MEM_LIMIT=256m
MYSQL_MEM_LIMIT=768m
AUTOHEAL_MEM_LIMIT=64m
# HTTPS port for Live Talk. Browsers only expose the microphone API
# (navigator.mediaDevices) in a secure context, so http://<HOST_IP>:3001 cannot
# record. Open https://<HOST_IP>:3443, and install the generated CA (served at
# /ca.pem) once per device to remove the browser warning. Set 0 to disable.
HTTPS_PORT=3443
# --- endpoint cameras (ONVIF) ------------------------------------------------
# Master switch for the room-camera preview shown during a two-way call.
CAMERA_ENABLED=true
# Key for encrypting camera passwords at rest (AES-256-GCM). Keep it stable:
# changing it makes stored camera passwords unreadable. Generate with:
#   openssl rand -base64 32
CAMERA_SECRET=CHANGE_ME_camera_secret
# go2rtc (RTSP -> WebRTC bridge) container ceiling; no transcoding happens, so
# this is mostly the WebRTC/SDP bookkeeping, not video.
CAMERA_MEM_LIMIT=192m