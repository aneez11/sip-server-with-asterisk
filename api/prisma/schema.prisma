generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
}

model Endpoint {
  id                  Int               @id @default(autoincrement())
  extension           String            @unique
  label               String
  location            String            @default("")
  type                String // phone | speaker
  isActive            Boolean           @default(true)
  sipPassword         String
  userAgent           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  zones               ZoneMember[]
  paGroupsAsInitiator PaGroup[]         @relation("PaInitiator")
  paGroupsAsReceiver  PaGroupReceiver[]
  camera              EndpointCamera?
  cameraRecord        Camera?           @relation("EndpointCameraLink")
  bellTargets         BellEndpoint[]
}

// A camera is a first-class record: it may exist on its own (corridor, gate)
// or be linked to one endpoint so a two-way call can show the room.
model Camera {
  id              Int       @id @default(autoincrement())
  name            String    @default("")
  location        String    @default("")
  // Optional 1:1 link: at most one camera serves a given endpoint.
  endpointId      Int?      @unique
  endpoint        Endpoint? @relation("EndpointCameraLink", fields: [endpointId], references: [id], onDelete: SetNull)
  enabled         Boolean   @default(false)
  host            String    @default("")
  port            Int       @default(80)
  username        String    @default("")
  passwordCipher  String    @default("")
  // Multi-sensor cameras / NVR-fronted groups expose several channels.
  channel         Int       @default(1)
  profileToken    String    @default("")
  profileName     String    @default("")
  rtspUri         String    @default("")
  snapshotUri     String    @default("")
  preferredStream String    @default("sub")
  // Real codec as pulled over RTSP (ONVIF's report can lie: UNV cameras say
  // H264 while streaming H265). Used to decide on transcoding.
  streamCodec     String    @default("")
  streamWidth     Int?
  streamHeight    Int?
  lastCheckAt     DateTime?
  lastCheckOk     Boolean?
  lastCheckError  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled])
  @@index([name])
}

// Optional ONVIF camera attached to a room endpoint. Credentials are stored
// encrypted (see api/src/lib/secret-box.ts) and never leave the API.
model EndpointCamera {
  id              Int       @id @default(autoincrement())
  endpointId      Int       @unique
  endpoint        Endpoint  @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  enabled         Boolean   @default(false)
  host            String
  port            Int       @default(80)
  username        String    @default("")
  passwordCipher  String    @default("")
  // Multi-sensor cameras / NVR-fronted groups expose several channels.
  channel         Int       @default(1)
  profileToken    String    @default("")
  profileName     String    @default("")
  rtspUri         String    @default("")
  snapshotUri     String    @default("")
  preferredStream String    @default("sub")
  // Real codec as pulled over RTSP (ONVIF's report can lie: UNV cameras say
  // H264 while streaming H265). Used to decide on transcoding.
  streamCodec     String    @default("")
  streamWidth     Int?
  streamHeight    Int?
  lastCheckAt     DateTime?
  lastCheckOk     Boolean?
  lastCheckError  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Zone {
  id                  Int          @id @default(autoincrement())
  name                String       @unique
  beep                Boolean      @default(true)
  volume              Int?
  announcementId      Int?
  autoAnswerProfileId Int?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  members             ZoneMember[]
  bells               BellZone[]
}

model AutoAnswerProfile {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  userAgentMatch String?
  alertInfo      String?
  callInfo       String?
  sipUri         String?
  dTime          Int?
  dialOptions    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ZoneMember {
  zoneId     Int
  endpointId Int
  zone       Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@id([zoneId, endpointId])
}

model BroadcastLog {
  id          Int       @id @default(autoincrement())
  status      String // pending | success | partial | failed
  zoneId      Int?
  endpointIds Json
  title       String    @default("")
  durationSec Float? // expected playback length (from the announcement)
  // manual | bell | music | talk | pa — lets History badge autonomous pages
  // without joining the bell ledger.
  source      String    @default("manual")
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
}

model Announcement {
  id              Int       @id @default(autoincrement())
  name            String
  filename        String
  originalName    String
  originalFile    String    @default("")
  fileSize        Int
  duration        Float? // seconds of the normalized WAV (for progress bars)
  flash           Boolean   @default(false)
  music           Boolean   @default(false)
  broadcast       Boolean? // null = legacy row: !music
  createdAt       DateTime  @default(now())
  paGroupsAsStart PaGroup[] @relation("PaStart")
  paGroupsAsEnd   PaGroup[] @relation("PaEnd")
  bells           Bell[]    @relation("BellAudio")
}

model EndpointCodecLog {
  id              Int      @id @default(autoincrement())
  endpointId      Int?
  extension       String   @default("")
  endpointModel   String   @default("")
  negotiatedCodec String
  broadcastId     Int?
  createdAt       DateTime @default(now())

  @@index([endpointId])
  @@index([createdAt])
}

// Initator/Receiver PA group. A user dials `extension` on the initiator device
// to start a one-to-many announcement to the receiver endpoints. pa_start /
// pa_end play at the boundaries. Fully static dialplan + dynamic member legs
// (the receiver list is resolved via the API at trigger time).
model PaGroup {
  id                    Int               @id @default(autoincrement())
  name                  String            @unique
  extension             String            @unique
  // Device that may trigger the group (null = any endpoint dialing `extension`).
  initiatorEndpointId   Int?
  initiatorEndpoint     Endpoint?         @relation("PaInitiator", fields: [initiatorEndpointId], references: [id], onDelete: SetNull)
  paStartAnnouncementId Int?
  paStartAnnouncement   Announcement?     @relation("PaStart", fields: [paStartAnnouncementId], references: [id], onDelete: SetNull)
  paEndAnnouncementId   Int?
  paEndAnnouncement     Announcement?     @relation("PaEnd", fields: [paEndAnnouncementId], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  // Receiver endpoints (the ones that hear the announcement).
  receivers             PaGroupReceiver[]
}

// Join table: a PA group's receiver endpoints.
model PaGroupReceiver {
  groupId    Int
  endpointId Int
  group      PaGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@id([groupId, endpointId])
}

// ---- scheduled bells (school chimes / shift bells) -------------------------
// Every schedule field is a WALL-CLOCK string interpreted in BELL_TIMEZONE.
// Only BellOccurrence.scheduledAt is a derived UTC instant (ordering + dispatch
// queries); storing "07:45" as a timestamp is how chimes end up an hour off.

model Bell {
  id             Int       @id @default(autoincrement())
  name           String    @default("")
  timeOfDay      String // "HH:MM" local, minute granularity
  // CSV of ISO weekdays 1=Mon .. 7=Sun, e.g. "1,2,3,4,5".
  daysOfWeek     String    @default("1,2,3,4,5")
  // Term window, inclusive, local "YYYY-MM-DD" strings ("" = unbounded).
  dateFrom       String    @default("")
  dateTo         String    @default("")
  enabled        Boolean   @default(true)
  announcementId Int?
  announcement   Announcement? @relation("BellAudio", fields: [announcementId], references: [id], onDelete: SetNull)
  // A bell's clip is its attention sound; its own beep/volume apply instead of
  // the zone's operator-broadcast settings.
  beep           Boolean   @default(false)
  volume         Int? // 0-100, pushed as PVOL on member legs
  templateId     Int? // Phase 3 (null = always-on set)
  template       BellTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  zones       BellZone[]
  endpoints   BellEndpoint[]
  occurrences BellOccurrence[]
  skips       BellSkip[]

  @@index([enabled])
  @@index([timeOfDay])
}

model BellZone {
  bellId Int
  zoneId Int
  bell   Bell @relation(fields: [bellId], references: [id], onDelete: Cascade)
  zone   Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([bellId, zoneId])
}

model BellEndpoint {
  bellId     Int
  endpointId Int
  bell       Bell     @relation(fields: [bellId], references: [id], onDelete: Cascade)
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@id([bellId, endpointId])
}

// Materialized occurrence. The unique key rings a bell exactly once per local
// minute — including across a DST fall-back hour where the local minute repeats.
model BellOccurrence {
  id            Int      @id @default(autoincrement())
  bellId        Int
  bell          Bell     @relation(fields: [bellId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime // UTC instant of the local wall clock
  localDate     String // "2026-11-22" (BELL_TIMEZONE)
  localMinute   String // "07:45"
  // scheduled | firing | fired | skipped | missed | failed
  status        String   @default("scheduled")
  reason        String   @default("") // "paused" | "dst" | "holiday" | "busy" | error
  resultStatus  String   @default("") // success | partial | failed (from the log)
  broadcastLogId Int?    @unique
  claimedAt     DateTime?
  firedAt       DateTime?
  createdAt     DateTime @default(now())

  @@unique([bellId, localDate, localMinute])
  @@index([status, scheduledAt])
  @@index([scheduledAt])
}

// Date-level exceptions. bellId null = every bell (holiday / vacation day).
model BellSkip {
  id     Int    @id @default(autoincrement())
  date   String // local "YYYY-MM-DD"
  bellId Int?
  bell   Bell?  @relation(fields: [bellId], references: [id], onDelete: Cascade)
  reason String @default("")

  @@unique([date, bellId])
  @@index([date])
}

// Phase 3: a named set of bells (Regular day / Half day / Exam day). Exactly one
// template is active; per-date overrides switch a single day's set.
model BellTemplate {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bells     Bell[]
  overrides BellTemplateOverride[]
}

model BellTemplateOverride {
  id         Int          @id @default(autoincrement())
  date       String // local "YYYY-MM-DD"
  templateId Int
  template   BellTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([date])
}

// Singleton (id = 1): the pause switch is site state and must survive restarts.
model BellSetting {
  id        Int      @id @default(1)
  paused    Boolean  @default(false)
  pausedBy  String   @default("")
  pausedAt  DateTime?
  updatedAt DateTime @updatedAt
}

// Created by express-mysql-session at runtime (NOT managed by Prisma). Column
// types mirror the runtime-created table so `prisma db push` doesn't alter it.
model sessions {
  session_id String  @id @db.VarChar(128)
  expires    Int     @db.UnsignedInt
  data       String? @db.MediumText
}
